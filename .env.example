POSTGRES_USER=dagster
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dagster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_WEBSERVER_PORT=3000
DAGSTER_CODE_PORT=4000

# Deployment and external-service settings.
VNSTOCK_TELEMETRY=off
SSI_HISTORY_URL=https://iboard-api.ssi.com.vn/statistics/charts/history
SOURCE_HTTP_TIMEOUT_SECONDS=30
SOURCE_HTTP_MAX_ATTEMPTS=3
RAW_STORAGE_PATH=storage/raw
PIPELINE_CONFIG_PATH=config.yml

# Local ELT development only (dbt/DuckDB/Mongo/warehouse Postgres).
# Not used by compose.yml, scripts/deploy.sh, or the VPS deployment.
# Bring up compose.dev.yml before running scripts/*_elt*.py or dbt.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_PORT=27017
MONGO_DATABASE=stock_etl_bronze
MONGO_URI=mongodb://root:change-me@localhost:27017/?authSource=admin

WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_PASSWORD=change-me
WAREHOUSE_POSTGRES_DB=warehouse
WAREHOUSE_POSTGRES_PORT=5433
WAREHOUSE_POSTGRES_DSN=postgresql://warehouse:change-me@localhost:5433/warehouse

DUCKDB_PATH=storage/warehouse/warehouse.duckdb
DBT_PROFILES_DIR=src/data_pipeline/dbt
