POSTGRES_USER=dagster
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dagster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_WEBSERVER_PORT=3000
DAGSTER_CODE_PORT=4000

# Source ingestion defaults. CLI arguments can override these per run.
VNSTOCK_PROVIDER=kbs
VNSTOCK_TELEMETRY=off
SSI_HISTORY_URL=https://iboard-api.ssi.com.vn/statistics/charts/history
SOURCE_HTTP_TIMEOUT_SECONDS=30
SOURCE_HTTP_MAX_ATTEMPTS=3
RAW_STORAGE_PATH=storage/raw
# Comma-separated stock tickers; all are crawled for each daily partition.
STOCK_SYMBOLS=FPT
# A single fund/ETF ticker in the current implementation.
FUND_SYMBOL=E1VFVN30
